<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>IntelligenceX.Shared</Title>
    <Description>Shared IntelligenceX contracts and catalogs used by the core SDK and supported IntelligenceX hosts.</Description>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <PackageId>IntelligenceX.Shared</PackageId>
    <PackageTags>intelligencex;contracts;tooling;netstandard2.0</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/IntelligenceX</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RequireLicenseAcceptance>false</RequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/EvotecIT/IntelligenceX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
