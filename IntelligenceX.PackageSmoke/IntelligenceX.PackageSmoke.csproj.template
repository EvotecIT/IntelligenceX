<Project Sdk="Microsoft.NET.Sdk">
  <!-- The package gate materializes this isolated consumer beside its staged feed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0</PackageVersion>
    <LedgerPackageVersion Condition="'$(LedgerPackageVersion)' == ''">0.1.0</LedgerPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IntelligenceX" Version="$(PackageVersion)" />
    <PackageReference Include="IntelligenceX.Storage.SQLite" Version="$(PackageVersion)"
                      Condition="'$(TargetFramework)' != 'net472'" />
    <PackageReference Include="IntelligenceX.Ledger.Contracts" Version="$(LedgerPackageVersion)"
                      Condition="'$(TargetFramework)' != 'net472'" />
  </ItemGroup>
</Project>
