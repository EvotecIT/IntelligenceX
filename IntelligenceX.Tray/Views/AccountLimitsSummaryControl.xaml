<UserControl x:Class="IntelligenceX.Tray.Views.AccountLimitsSummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IntelligenceX.Tray.Converters"
             xmlns:vm="clr-namespace:IntelligenceX.Tray.ViewModels">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
        <conv:InverseBoolToVisibilityConverter x:Key="VisibleWhenFalse" />
    </UserControl.Resources>
    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Account limits" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="Online account capacity · separate from local token activity below"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="No account-limit reading yet. Local activity does not establish remaining capacity."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding HasLimitSection, Converter={StaticResource VisibleWhenFalse}}" />
            <TextBlock Text="{Binding LimitStatusDisplayText}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding HasLimitStatusDisplayText, Converter={StaticResource VisibleWhenTrue}}" />
            <TextBlock Text="{Binding LimitAccountsOverviewText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding HasLimitAccountsOverview, Converter={StaticResource VisibleWhenTrue}}" />
            <ItemsControl ItemsSource="{Binding LimitAccounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderLimitAccountViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,10,0,6" Margin="0,6,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BadgeText}"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Visibility="{Binding HasDetailText, Converter={StaticResource VisibleWhenTrue}}" />
                                <ItemsControl ItemsSource="{Binding Windows}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProviderLimitWindowViewModel}">
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UsedPercentFormatted, StringFormat={}{0} used}" Margin="10,0"
                                                           FontSize="11" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ResetText}" TextAlignment="Right"
                                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
