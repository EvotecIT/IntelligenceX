<UserControl x:Class="IntelligenceX.Tray.Views.AccountLimitsSummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IntelligenceX.Tray.Converters"
             xmlns:vm="clr-namespace:IntelligenceX.Tray.ViewModels"
             FontFamily="{DynamicResource AppFont}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
        <conv:InverseBoolToVisibilityConverter x:Key="VisibleWhenFalse" />
        <Style x:Key="AccountCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PulseHeroBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CapacityBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3.5"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapacityLow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,2,0,16">
        <Grid Margin="2,0,2,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PulseGlassBrush}" Margin="0,0,10,0">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Accounts" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Live capacity · separate from local activity" FontSize="12" Margin="0,3,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding LimitAccountsOverviewText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Visibility="{Binding HasLimitAccountsOverview, Converter={StaticResource VisibleWhenTrue}}" />
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasLimitSection, Converter={StaticResource VisibleWhenFalse}}">
            <StackPanel>
                <TextBlock Text="No live account reading yet" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Local token activity remains available below. Capacity requires an online account reading."
                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource PulseWarningPanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasLimitStatusDisplayText, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding LimitStatusDisplayText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" />
        </Border>
        <ItemsControl ItemsSource="{Binding LimitAccounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProviderLimitAccountViewModel}">
                    <Border Style="{StaticResource AccountCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PulseGlassBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding PlanLabel}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding HasPlanLabel, Converter={StaticResource VisibleWhenTrue}}" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource PulseGlassBrush}" CornerRadius="6" Padding="8,4"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasBadge, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Expander Grid.Column="3" Header="Details" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          FontSize="11" Margin="8,0,0,0"
                                          VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                                    <StackPanel Margin="0,6,0,0" MaxWidth="300">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasDetailText, Converter={StaticResource VisibleWhenTrue}}" />
                                    </StackPanel>
                                </Expander>
                                <Button Grid.Column="4" Content="Resets" Style="{DynamicResource RefreshButtonStyle}" Padding="8,4"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Click="ManageResets_Click"
                                        AutomationProperties.Name="Banked resets for this account"
                                        ToolTip="View or record reset credits for this account. This does not redeem a reset."
                                        Visibility="{Binding CanManageResets, Converter={StaticResource VisibleWhenTrue}}" />
                            </Grid>
                            <TextBlock Text="{Binding ReadingText}" FontSize="11" Margin="38,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding Windows}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProviderLimitWindowViewModel}">
                                        <StackPanel Margin="0,4,0,2">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold"
                                                           Margin="10,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CompactLabel}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding ResetText}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource CapacityBar}" Minimum="0" Maximum="100" Value="{Binding RemainingPercent, Mode=OneWay}"
                                                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding RemainingText}"
                                                         Visibility="{Binding HasUsage, Converter={StaticResource VisibleWhenTrue}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
