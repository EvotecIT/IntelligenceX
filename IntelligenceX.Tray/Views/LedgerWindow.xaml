<Window x:Class="IntelligenceX.Tray.Views.LedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IX Work Ledger" Width="980" Height="740" MinWidth="700" MinHeight="540"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            </Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            </Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Read settings…" Click="OnChooseSettings" Style="{DynamicResource RefreshButtonStyle}" Padding="12,6" Margin="12,0,8,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{DynamicResource RefreshButtonStyle}" Padding="12,6" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Work across your computers" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Coverage}" TextWrapping="Wrap" Margin="0,16,0,12" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" RowDetailsVisibilityMode="Collapsed"
                  Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  FontSize="13" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Work" Binding="{Binding Label}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="State" Binding="{Binding Verdict}" Width="100" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Item.Provider}" Width="80" />
                <DataGridTextColumn Header="Computer" Binding="{Binding Item.MachineId}" Width="100" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Item.ReasonCode}" Width="130" />
                <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" Padding="14" Margin="0,12,0,0" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
