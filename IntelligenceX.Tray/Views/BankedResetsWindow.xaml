<Window x:Class="IntelligenceX.Tray.Views.BankedResetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IX Tray · Banked resets" Width="620" Height="680" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="{DynamicResource AppFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource RefreshButtonStyle}" />
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Margin="24">
            <TextBlock Text="Banked resets" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="AccountText" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="Recorded inventory · not a live balance" FontWeight="SemiBold" />
                    <TextBlock Text="Manual entries are local notes. Verify them with the provider before use. No action here redeems a reset or starts a usage window."
                               TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock x:Name="AdviceText" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <ListBox x:Name="CreditList" Margin="0,16,0,8" MinHeight="90" MaxHeight="210"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel>
                <Button Content="Record as used" Click="RecordUsed_Click" Padding="10,6" Margin="0,0,8,8" />
                <Button Content="Remove entry" Click="Remove_Click" Padding="10,6" Margin="0,0,8,8" />
                <Button Content="Refresh inventory" Click="Refresh_Click" Padding="10,6" Margin="0,0,0,8" />
            </WrapPanel>
            <Separator Margin="0,8" />
            <TextBlock Text="Add a manual entry" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,10" />
            <TextBlock Text="Restores" Margin="0,0,0,4" />
            <ComboBox x:Name="ScopePicker" Style="{DynamicResource FilterComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,10" AutomationProperties.Name="Reset scope">
                <ComboBoxItem Content="Full reset · applicable windows" Tag="Full" />
                <ComboBoxItem Content="Weekly window" Tag="Weekly" />
                <ComboBoxItem Content="Short window · if reported" Tag="ShortWindow" />
                <ComboBoxItem Content="Scope unknown" Tag="Unknown" />
            </ComboBox>
            <TextBlock Text="Expiry date (optional, end of local day)" Margin="0,0,0,4" />
            <DatePicker x:Name="ExpiryPicker" AutomationProperties.Name="Reset expiry date"
                        Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" Padding="6" />
            <TextBlock Text="Leave blank when expiry is unknown. Check the provider’s exact expiry time before use."
                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10" Foreground="{DynamicResource SecondaryTextBrush}" />
            <Button Content="Add manual reset" Click="Add_Click" HorizontalAlignment="Left" Padding="12,7" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Window>
