<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IX Ledger tray (Windows) and menu bar (macOS) app: shows whether the Ledger is running and whether GitHub, Codex
    and Claude are signed in on each machine, with a history of what changed. It only reads the Ledger.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>IntelligenceX.Ledger.Tray</AssemblyName>
    <RootNamespace>IntelligenceX.Ledger.Tray</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <ApplicationIcon>..\IntelligenceX.Tray\Resources\tray-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IntelligenceX.Ledger.Contracts\IntelligenceX.Ledger.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntelligenceX.Ledger.Tests" />
  </ItemGroup>
</Project>
